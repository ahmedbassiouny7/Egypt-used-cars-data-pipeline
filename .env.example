AIRFLOW_UID=50000
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow
AIRFLOW_IMAGE_NAME=egypt-used-cars-airflow:local

# Scraping settings used by the DAG.
HATLA2EE_BASE_URL=https://eg.hatla2ee.com/en/car/page
# 0 means auto mode. Use a fixed number like 5 for testing or 573/570 for a full run cap.
HATLA2EE_MAX_PAGES=5

# Reference-price scraper settings.
HATLA2EE_USED_PRICES_URL=https://eg.hatla2ee.com/en/car/used-prices
# 0 means scrape all brands found on the used-prices page. Use 2 for a quick test.
HATLA2EE_PRICE_REFERENCE_MAX_BRANDS=0

# Warehouse Postgres used for raw and cleaned car data.
CARS_DB_HOST=cars-postgres
CARS_DB_PORT=5432
CARS_DB_NAME=cars_dw
CARS_DB_USER=cars_user
CARS_DB_PASSWORD=cars_password
